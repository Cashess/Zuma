generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @id @unique @default(uuid()) // Using UUID
  email             String            @unique
  firstName         String
  lastName          String
  profileImage      String
  createdAt         DateTime          @default(now())
  orders            Order[] // Correctly named for pluralization
  shippingAddresses ShippingAddress[] // Allows multiple addresses
  billingAddresses  BillingAddress[] // Allows multiple addresses
}

model Product {
  id          String        @id @default(uuid())
  name        String
  description String
  status      ProductStatus
  priceStat   Int
  images      String[]
  category    Category
  isFeatured  Boolean       @default(false) // Add the isFeatured field
}

enum ProductStatus {
  draft
  published
  archived
}

enum Category {
  kitchen
  electronics
  homeMadeCraft
}

model Banner {
  id          String   @id @default(uuid())
  title       String
  imageString String
  createdAt   DateTime @default(now())

  @@map("Banner") // Maps the model to the table named "Banner"
}

model Order {
  id                String           @id @default(uuid())
  status            OrderStatus      @default(PENDING) // Use an enum for status
  amount            Int
  userId            String? // Optional user relation
  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingAddressId String? // Optional shipping address relation
  billingAddressId  String? // Optional billing address relation
  shippingAddress   ShippingAddress? @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress    BillingAddress?  @relation(fields: [billingAddressId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
}

// Enum for order status to improve readability and maintain consistency
enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  SHIPPED
}

model ShippingAddress {
  id          String  @id @default(uuid()) // Changed to String for consistency
  line1       String
  line2       String?
  city        String
  state       String
  postal_code String
  country     String
  userId      String // Changed to String for consistency
  user        User    @relation(fields: [userId], references: [id])
  orders      Order[] // Changed to plural to reflect the relation
}

model BillingAddress {
  id          String  @id @default(uuid()) // Changed to String for consistency
  line1       String
  line2       String?
  city        String
  state       String
  postal_code String
  country     String
  userId      String // Changed to String for consistency
  user        User    @relation(fields: [userId], references: [id])
  orders      Order[] // Changed to plural to reflect the relation
}
